# Environment Configuration for AquaSense AI
FLASK_ENV=development
FLASK_PORT=5000

# Google Gemini API Key for Aqua AI Chat Assistant (Required for real AI responses)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Ingestion Security Key for triggering /api/data/ingest
DATA_INGEST_KEY=aquasense2024

